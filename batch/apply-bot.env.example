#!/usr/bin/env bash
# Apply-bot identity config — EDIT THIS FILE with your own details.
# This file is gitignored (batch/apply-bot.env) and never committed.
# Copy from batch/apply-bot.env.example to batch/apply-bot.env and fill in.

# Candidate identity
APPLY_FULL_NAME="Your Full Name"
APPLY_FIRST_NAME="YourFirst"
APPLY_LAST_NAME="YourLast"
APPLY_PHONE_WITH_CODE="+91 9876543210"
APPLY_PHONE_LOCAL="9876543210"
APPLY_LOCATION="Your City, Your Country"
APPLY_COMPANY="Your Current Company"
APPLY_LINKEDIN="https://www.linkedin.com/in/your-profile"
APPLY_GITHUB="https://github.com/your-username"
APPLY_EDUCATION="Your Degree, Your University, Year"
APPLY_SALARY="$100K-$180K"
APPLY_NOTICE="Immediate"
APPLY_START="Immediate"

# Browser profile (Playwright user-data-dir — set per machine)
APPLY_BROWSER_DIR="$HOME/.career-ops-playwright"
# Folders for your tailored resumes and cover letters (create these yourself)
APPLY_RESUME_DIR="$HOME/Desktop/my-resumes"
APPLY_COVER_DIR="$HOME/Desktop/my-cover-letters"
